    <!-- Body part 1 html -->

    <div class="container-fluid my-1 height style" >
        <div class="row">
            <div class="col-sm-6 head" style="font-family: roboto;font-weight: bold;font-size:25px;">Welcome To Employee Dashboard</div>
            <div class="col-sm-6" style="display: flex; justify-content: end">
                <a href="#" id="logout_1">Logout</a>
            </div>
        </div>
    </div>

    <!-- Body part 2 html -->


    <div class="password_box" id="dropdownMenu_1">
        <div class="password">
            <form id="password_form">
                <input type="text" placeholder="Previous Password" id="Previous_Password" /><br /><br />
                <small id="previous_erro"></small>

                <input type="text" placeholder="New Password" id="new_password" /><br /><br />
                <small id="new_password_error"></small> <br>
                <button type="submit">chanage Password</button>
            </form>
        </div>
    </div>

    <!-- End of password chanaging html -->

    <div class="container-fluid my-5">
        <div class="row">
            <div class="col-12" style="display: flex; justify-content: center">
                <h2>Account Details</h2>
            </div>
        </div>
    </div>

    <!-- body part3 html   -->

    <div class="container-fluid my-5">
        <div class="row">
            <div class="col-12">
                <ul class="nav nav-tabs justify-content-around ">
                    <!-- <li class="nav-item">
                        <a class="nav-link  color" aria-current="page" id="Employee_Details">Account Details</a>
                    </li> -->
                    <li class="nav-item">
                        <a class="nav-link  color" href="#" id="Add_customer">Add Customer</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link color" href="#" id="Remove_customer">Remove Customer</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link color" href="#" id="Credit_Funds" aria-disabled="true">Credit Funds</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link color" href="#" id="Debit_Funds" aria-disabled="true">Debit Funds</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link color" href="#" id="Transfer_funds" aria-disabled="true">Transfer Fund</a>
                    </li>

                    <li class="nav-item ">
                        <a  class="nav-link color active" href="#" id="check_pay">pay check</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Body part4 html -->

    <div class="container-fluid my-5" >
        <div class="row">
            <div class="col-12" style="display: flex; justify-content: center">
                <h3>Pay check</h3>
            </div>
        </div>
    </div>

  


    <div class="container-fluid" style="margin-top:-100px;">
        <div class="row">
            <div class="col-12">
                <center>
                    <form id="form">
                    
                    <div class="col-md-6 pad-top">
                        <input type="text" class="form-control" placeholder="Check No ...." id="check_Number">
                        <small id="check_Number_error"></small>
                    </div>

                    <div class="col-md-6 pad-top">
                        <input type="text" class="form-control" placeholder="Pay To ...." id="pay_To">
                        <small id="pay_To_error"></small>
                    </div>

                     <div class="col-md-6 pad-top">
                        <input type="text" class="form-control" placeholder="Account No ...." id="Account_Number">
                        <small id="Account_Number_error"></small>
                    </div>

                     <div class="col-md-6 pad-top">
                        <input type="text" class="form-control" placeholder="Amount ...." id="Amount">
                        <small id="Amount_error"></small>
                    </div>


                     <div class="col-md-6 pad-top" style="margin-bottom:10px;">
                       
                        <select class="form-control" id="status">
                            <option name="" id="">Select Status....</option>
                            <!-- <option name="" id="">pending</option> -->
                            <option name="cleared" id="">cleared</option>
                            <!-- <option name="" id="">bounced</option> -->
                            <option name="cancelled" id="">cancelled</option>
                        </select>
                        <small id="smal_status"></small>
                    </div>

                    <div class="col-md-6 pad-top" style="margin-bottom:10px;">
                        <button class="btn btn-primary" type="submit">pay Check</button>
                    </div>

                     

                    
                </form>
                </center>
            </div>
        </div>
    </div>




    
    <script src="/Bootsrap/bootstrap.bundle.min.js"></script>
    <script src="/javascript/login_system_js/Employee_js/Employee_pay_check_js.js"></script>
    <script src="/javascript/login_system_js/Employee_pages_Router_js/Employee_chech_Router.js"></script>
    <script src="/javascript/login_system_js/Employee_js/Employee_change_password_js.js"></script>

