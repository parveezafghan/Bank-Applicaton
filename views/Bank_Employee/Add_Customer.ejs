            font-size: 17px;
            font-weight: bold;
        }

        @media print {

            body * {

                visibility: hidden;
            }

            .Bank_card {

                visibility: visible;
                position: relative;
                /* left:0;
                right:0;
                width:400px;
                padding:30px; */
