            }

            .card_header_1 {
                visibility: visible;
            }

            .card_header_2 {
                visibility: visible;
            }

            .imgs {
                visibility: visible;
            }

            .img_1,
            .img_2 {

                visibility: visible;
            }

            .number {
                visibility: visible;
            }

            .date {
                visibility: visible;
            }

            .Num {
                visibility: visible;
            }

            .show {
                visibility: visible;
            }

            .table {

                visibility: visible;
                padding-left: -100px;
            }

            #head {

                visibility: visible;
            }

            hr {
                visibility: visible;
            }

            #body {

                visibility: visible;
            }

            th {

                visibility: visible;
            }

            td {

                visibility: visible;
            }
        }



        .show_card {

            display: block;
        }

        .button {

            display: none;
        }

        .show_button {
            /* visibility:visible; */
            display: block;
        }

        .info_advice {

            display: flex;
            justify-content: center;
            display: none;
        }

        .h5 {

            font-size: 30px;
            font-weight: bold;
            padding-bottom: 30px;

        }

        .table {

            display: none;
        }

        .show_info {

            display: flex;
            justify-content: center;

        }

        .show_table {

            display: block;
        }


