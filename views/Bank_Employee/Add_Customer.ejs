                <small id="check_Last_Name"></small>
            </div>

            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">F Name</div>
                    <input type="text" class="form-control" id="F_Name">

                </div>
                <small id="check_F_Name"></small>
            </div>
            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Email</div>
                    <input type="email" class="form-control" id="Email">
                </div>
                <small id="check_Email"></small>
            </div>
            <div class="col-sm-4 margin_bottom ">
                <div class="input-group">
                    <div class="input-group-text">Mobile Number</div>
                    <input type="text" class="form-control" id="Number">

                </div>
                <small id="check_Number"></small>
            </div>
            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Data Birth</div>
                    <input type="date" class="form-control" id="Date">

                </div>

                <small id="check_Date"></small>
            </div>
            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Account Number</div>
                    <input type="text" class="form-control" id="Account_Number">

                </div>
                <small id="check_Account_Number"></small>
            </div>


            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Card Number</div>
                    <input type="text" class="form-control" id="card_Number">

                </div>
                <small id="check_card_Number"></small>
            </div>


            <div class="col-sm-4 margin_bottom">


                <select class="form-select" id="Account_Type">
                    <option selected disabled>Choose Account Type...</option>
                    <option value="saving">Saving</option>
                    <option value="student">student</option>
                    <option value="Fixed">Fixed</option>
                </select>

                <small id="check_Account_Type"></small>
            </div>


            <div class="col-sm-4 margin_bottom">


                <select class="form-select " id="Branch" id="Branch_id">
                    <option value="" selected disabled>Select The Branch...</option>
                </select>

                <small id="check_Branch"></small>
            </div>

            <div class="col-sm-4 margin_bottom">


                <select class="form-select " id="Card">
                    <option value="" selected disabled>Select The Card...</option>
                    <option value="Debit">Debit</option>
                    <option value="Credit">Credit</option>
                    <option value="Prepaid">Prepaid</option>
                    <option value="ATM">ATM</option>
                </select>

                <small id="check_card"></small>
            </div>



            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Account Balance</div>
                    <input type="number" class="form-control" id="Amount">

                </div>
                <small id="check_Amount"></small>
            </div>


            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">Address</div>
                    <input type="text" class="form-control" id="Address">

                </div>
                <small id="check_address"></small>
            </div>

            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">City</div>
                    <input type="text" class="form-control" id="City">

                </div>
                <small id="check_City"></small>
            </div>

            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">District</div>
                    <input type="text" class="form-control" id="District">

                </div>
                <small id="check_District"></small>
            </div>

            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">PinCode</div>
                    <input type="number" class="form-control" id="pin_code">

                </div>
                <small id="check_pin_code"></small>
            </div>


            <div class="col-sm-4 margin_bottom">

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Male" value="option1">
                    <label class="form-check-label" for="inlineRadio1">Male</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Female" value="option2">
                    <label class="form-check-label" for="inlineRadio2">Female</label>
                </div>

                <small id="check_Gender"></small>

            </div>



            <div class="col-sm-4">

                <div class="col-12 form-check form-switch">
                    <input class="form-check-input" type="checkbox" value="" id="check" switch>
                    <label class=" col-4 form-check-label" for="checkNativeSwitch">
                        Check Form
                    </label>

                </div>

            </div>

            <div class="col-sm-4 margin_bottom d-grid gap-2  mx-auto">

                <button class="btn btn-outline-success" type="submit">Submit</button>
            </div>

            <div class="col-sm-4 margin_bottom d-grid gap-2 ">

                <button class="btn btn-outline-success" type="reset">Reset</button>
            </div>
        </form>


    </div>



