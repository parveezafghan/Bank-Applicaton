    <!-- body part 3 html -->


    <div class="container-fluid my-5">
        <div class="row">
            <div class="col-6">
                <ul class="nav nav-tabs justify-content-around">
                    <li class="nav-item">
                        <a class="nav-link  color" aria-current="page" href="#"  id="Account_Details">Account Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active color" href="#">Transfer</a>
                    </li>
                </ul>
            </div>
        </div>
