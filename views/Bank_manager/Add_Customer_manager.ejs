                    <input type="text" class="form-control" id="Address">

                </div>
                <small id="check_address"></small>
            </div>

            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">City</div>
                    <input type="text" class="form-control" id="City">

                </div>
                <small id="check_City"></small>
            </div>

            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">District</div>
                    <input type="text" class="form-control" id="District">

                </div>
                <small id="check_District"></small>
            </div>

            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">PinCode</div>
                    <input type="number" class="form-control" id="pin_code">

                </div>
                <small id="check_pin_code"></small>
            </div>


            <div class="col-sm-4 margin_bottom">

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Male" value="option1">
                    <label class="form-check-label" for="inlineRadio1">Male</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Female" value="option2">
                    <label class="form-check-label" for="inlineRadio2">Female</label>
                </div>

                <small id="check_Gender"></small>

            </div>



            <div class="col-sm-4">

                <div class="col-12 form-check form-switch">
                    <input class="form-check-input" type="checkbox" value="" id="check" switch>
                    <label class=" col-4 form-check-label" for="checkNativeSwitch">
                        Check Form
                    </label>

                </div>

            </div>

            <div class="col-sm-4 margin_bottom d-grid gap-2  mx-auto">

                <button class="btn btn-outline-success" type="submit">Submit</button>
            </div>

            <div class="col-sm-4 margin_bottom d-grid gap-2 ">

                <button class="btn btn-outline-success" type="reset">Reset</button>
            </div>
        </form>


