                </div>
                <small id="check_Account_Number"></small>
            </div>


            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Card Number</div>
                    <input type="text" class="form-control" id="card_Number">

                </div>
                <small id="check_card_Number"></small>
            </div>


            <div class="col-sm-4 margin_bottom">


                <select class="form-select" id="Account_Type">
                    <option selected disabled>Choose Account Type...</option>
                    <option value="saving">Saving</option>
                    <option value="student">student</option>
                    <option value="Fixed">Fixed</option>
                </select>

                <small id="check_Account_Type"></small>
            </div>


            <div class="col-sm-4 margin_bottom">


                <select class="form-select " id="Branch" id="Branch_id">
