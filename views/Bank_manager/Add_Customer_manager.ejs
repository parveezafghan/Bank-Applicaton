                    <!-- <option value="saving">Saving</option>
                    <option value="student">student</option>
                    <option value="Fixed">Fixed</option> -->
                </select>

                <small id="check_Branch"></small>
            </div>

            <div class="col-sm-4 margin_bottom">


                <select class="form-select " id="Card">
                    <option value="" selected disabled>Select The Card...</option>
                    <option value="Debit">Debit</option>
                    <option value="Credit">Credit</option>
                    <option value="Prepaid">Prepaid</option>
                    <option value="ATM">ATM</option>
                </select>

                <small id="check_card"></small>
            </div>



            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Account Balance</div>
                    <input type="number" class="form-control" id="Amount">

                </div>
                <small id="check_Amount"></small>
            </div>


            <div class="col-sm-4 margin_bottom">

