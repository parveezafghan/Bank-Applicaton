    <script>


        let id=document.getElementById('user').dataset.id;

        console.log(id.split('-'));

         id=id.split('-');
         let Account_Number=id[1];
         id=id[0];

        //  alert(Account_Number);


         async function get_Customer(){


            
         let res=await fetch(`http://localhost:3000/Data_for_Edit_customer?Account_Number=`+Account_Number);


         let Result=await res.json();

         console.log(Result);
         if(Result.success){

            // alert('Sucess');

            let result=Result.result;

            document.getElementById('Amount').value=result[0].Balance;
            document.getElementById('First_Name').value=result[0].Name;
            document.getElementById("Last_Name").value=result[0].Last_Name;
            document.getElementById('F_Name').value=result[0].Father_Name;
            document.getElementById('Email').value=result[0].Eamil;
             document.getElementById('Number').value=result[0].Mobile_number;
             document.getElementById('pin_code').value=result[0].pin_code;
             document.getElementById('user_name').value=result[0].user_name;
             document.getElementById('password').value=result[0].password;
             document.getElementById('card_Number').value=result[0].card_number;


         }
         else{

            alert("Wronge");
         }

        


         }

         get_Customer();
         
         
    </script>


