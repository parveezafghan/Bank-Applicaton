    <script>


     document.getElementById('form').addEventListener('submit',(e)=>{


        e.preventDefault();


        let card_Number=document.getElementById("Card");
        let Date=document.getElementById("Date");
        let Name=document.getElementById("Name");
        let Card_type=document.getElementById('Card_type');
        let user_Name=document.getElementById('user_Name');
        let check=document.getElementById('check');
        let policy=document.getElementById("policy");

        if(check.checked){

            // alert("checked");
             policy.classList.remove('text-danger');
            check.classList.remove("is-invalid");


            
         let check_Card_Number=(card_Number)=>{

            let check_card_Number=document.getElementById('card_error');


         if(card_Number.value==='' || card_Number.value==='....                   ....             ....                 ....             '){


            card_Number.classList.add("is-invalid");
             check_card_Number.classList.add('text-danger');
             check_card_Number.innerHTML="Fill The Input";
         }

         let Card_number_Array=card_Number.value.split(" ");
         let First_card_number=Card_number_Array[0];
         let Second_card_number=Card_number_Array[1];
         let Third_card_number=Card_number_Array[2];
         let Fourth_card_number=Card_number_Array[3];


        //  let check_card_Number=document.getElementById('card_error');
         console.log("Array Lenght:",Card_number_Array.length);


         if(Card_number_Array.length<4 || Card_number_Array.length>4){

             card_Number.classList.add("is-invalid");
             check_card_Number.classList.add('text-danger');
             check_card_Number.innerHTML="Follow Format 1111 1111  1111 1111 ";

             return null;

         }
         else if(First_card_number.match(/[a-z]/g) || Second_card_number.match(/[a-z]/g) || Third_card_number.match(/[a-z]/g) || Fourth_card_number.match(/[a-z]/g)){


             card_Number.classList.add('is-invalid');
             check_card_Number.classList.add('text-danger');
             check_card_Number.innerHTML="Only Digit and Valid Format";


             return null;



         }
         else if(First_card_number.length>4||First_card_number.length<4 || Second_card_number.length>4 || Second_card_number.length<4 || Third_card_number.length<4||Third_card_number.length>4 || Fourth_card_number.length<4||Fourth_card_number.length>4){


              card_Number.classList.add('is-invalid');
              check_card_Number.classList.add('text-danger');
              check_card_Number.innerHTML="in each Feild 4 digit valid";

              return null;
         }
         else{

            card_Number.classList.remove("is-invalid");
            check_card_Number.classList.remove('text-danger');
            check_card_Number.innerHTML="";

            return card_Number;

         }



       }




        
       let check_Date=(Date)=>{

       let check_Date=document.getElementById('check_Date');


        if(Date.value==""){


            Date.classList.add("is-invalid");
            check_Date.classList.add("text-danger");
            check_Date.innerHTML="Fill The Data";

            return null;
        }
        else{


            Date.classList.remove('is-invalid');
            check_Date.classList.remove('text-danger');
            check_Date.innerHTML="";

            return Date;
        }

       }



       let check_Name=(Name)=>{


         let check_Name_=document.getElementById('check_Name');
         if(Name.value===""){

            Name.classList.add("is-invalid");
            check_Name_.classList.add('text-danger');
            check_Name_.innerHTML="Fill The Input";

            return null;

         }
         else if(Name.value.match(/[0-9]/g)){


            Name.classList.add("is-invalid");
            check_Name_.classList.add('text-danger');
            check_Name_.innerHTML="only Character";

            return null;

         }
         else{

            Name.classList.remove('is-invalid');
            check_Name_.classList.remove('text-danger');
            check_Name_.innerHTML="";

            return Name.value;
         }
       }



        let check_Card_type=(Card_type)=>{


        let check_card_type_=document.getElementById("check_card_type");
       

        if(Card_type.value=="" || Card_type.value=='Select The Card...' || Card_type.value==null){

            Card_type.classList.add("is-invalid");
            check_card_type_.classList.add("text-danger");
            check_card_type_.innerHTML="Select The Card";

            return null;
        }
        else if(Card_type.value=="ATM"){

            Card_type.classList.add("is-invalid");
            check_card_type_.classList.add('text-danger');
            check_card_type_.innerHTML="ATM Card Not Valid for Transaction";

            return null;

        }
        else{

            Card_type.classList.remove("is-invalid");
            check_card_type_.classList.remove('text-danger');
            check_card_type_.innerHTML="";

            return Card.value;
        }
         



       }



       let check_User_Name=(user_Name)=>{

        alert("in")

        let user_Name_err=document.getElementById("user_Name_err");

        if(user_Name.value===""){


            user_Name.classList.add("is-invalid");
            user_Name_err.classList.add("text-danger");
            user_Name_err.innerHTML="Fill The Input";

            return null;

        }
        else if(user_Name.value.match(/[0-9]/g)){


            user_Name.classList.add("is-invalid");
            user_Name_err.classList.add("text-danger");
            user_Name_err.innerHTML="only Character";

            return null;
        }
        else{


            user_Name.classList.remove("is-invalid");
            user_Name_err.classList.remove("text-danger");
            user_Name_err.innerHTML="";

            return user_Name.value;
        }
       }



       card_Number=check_Card_Number(card_Number);
       Date=check_Date(Date);
       Name=check_Name(Name);
       Card_type=check_Card_type(Card_type);
       user_Name=check_User_Name(user_Name);
       alert(user_Name);


       if(card_Number===null || Date==null || Name==null || Card_type==null || user_Name===null){

             let err_width_=document.getElementById('err_width');
             console.log(err_width_);
             err_width_.classList.add('err_width_');
             let label_=document.getElementsByTagName('label');
             console.log(label_)
             label_.classList.add('font_');

            alert("Fill The Form");
       }
        }
        else{

            
            policy.classList.add('text-danger');
            check.classList.add("is-invalid");
            alert("check The Terms and Condition policy");
        }
        // let  check_card_Number=document.getElementById("card_error");




     })

    </script>



