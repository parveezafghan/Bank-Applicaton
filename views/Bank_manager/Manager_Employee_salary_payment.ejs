                        <small id="user_Name_err"></small>

                    </div>


                    <div class="col-md-12 mt-2" >
                        <input type="checkbox" class="form-check-input" id="check" > <small class="font" id="policy">I have  Read and Agreed to The <strong>Terms and Conditions</strong> </small>
