                        <input type="date" class="form-control" id="Date" placeholder="....                   ....             ....                 ....             " id="check_Number">
                        <small id="check_Date"></small>
                    </div>

                    <div class="col-md-6 pad-top">
                        <label for="" class="font" >Name on card</label>
                        <input type="text" id="Name" class="form-control" placeholder="....                   ....             ....                 ....             " id="check_Number">
                        <small id="check_Name"></small>
                    </div>
                    </div>
                   </div>


                   <div class="col-md-12 mt-5" >



                 <select class="form-select " id="Card_type">
                    <option value="" selected disabled>Select The Card...</option>
                    <option value="Debit">Debit</option>
                    <option value="Credit">Credit</option>
                    <option value="Prepaid">Prepaid</option>
                    <option value="ATM">ATM</option>
                 </select>

                <small id="check_card_type"></small>
                       
                        <!-- <label for="Card Type"></label>
