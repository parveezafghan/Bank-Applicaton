                        </div>
                        <small id="Account_erro"></small>
                    </div>

                     <div class="col-auto">
                        <label class="visually-hidden" for="autoSizingSelect">Preference</label>
                        <select class="form-select" id="chanage_type">
                            <option selected disabled>Chanage Account State...</option>
                            <option value="active">Active</option>
                            <option value="block">Block</option>
                            
                        </select>
                        <small id="chanage_Error"></small>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-warning bt">Chanage Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>





    <div class="container" style="margin-top:100px;">
