    <div class="container">
        <div class="row">
            <div class="col-sm-12"><center><h4 style="padding-top:50px;font-size:30px;font-weight: bold;">Add New Employee</h4></center></div>
        </div>
    </div>

    <div class="container margin_top">

        <form class="row gy-2 gx-3 align-items-center" id="form">



                 <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">First Name</div>
                    <input type="text" class="form-control" id="First_Name">

                </div>
                <small id="check_First_Name"></small>
            </div>


            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Last Name</div>
                    <input type="text" class="form-control" id="Last_Name">

                </div>
                <small id="check_Last_Name"></small>
            </div>

            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">F Name</div>
                    <input type="text" class="form-control" id="F_Name">

                </div>
                <small id="check_F_Name"></small>
            </div>
            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Email</div>
                    <input type="email" class="form-control" id="Email">
                </div>
                <small id="check_Email"></small>
            </div>



              <div class="col-sm-4 margin_bottom ">
                <div class="input-group">
                    <div class="input-group-text">Mobile Number</div>
                    <input type="text" class="form-control" id="Number">

                </div>
                <small id="check_Number"></small>
            </div>


            <div class="col-sm-4 margin_bottom">


                <select class="form-select " id="Branch" id="Branch_id">
                    <option value="" selected disabled>Select The Branch...</option>
                </select>

                <small id="check_Branch"></small>
            </div>


               <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">PinCode</div>
                    <input type="number" class="form-control" id="pin_code">

                </div>
                <small id="check_pin_code"></small>
            </div>

            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">Salary</div>
                    <input type="text" class="form-control" id="salary">

                </div>
                <small id="salary_err"></small>
            </div>



             <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">Provienc</div>
                    <input type="text" class="form-control" id="provienc">

                </div>
                <small id="provienc_err"></small>
            </div>

            
            <div class="col-sm-4 margin_bottom">
                <div class="input-group">
                    <div class="input-group-text">District</div>
                    <input type="text" class="form-control" id="District">

                </div>
                <small id="check_District"></small>
            </div>

            <div class="col-sm-4 margin_bottom">

                <div class="input-group">
                    <div class="input-group-text">Zip Code</div>
                    <input type="text" class="form-control" id="zip_code">

                </div>
                <small id="zipe_code_err"></small>
            </div>

  




            <div class="col-sm-4 margin_bottom">

                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Male" value="option1">
                    <label class="form-check-label" for="inlineRadio1">Male</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="Gender" id="Female" value="option2">
                    <label class="form-check-label" for="inlineRadio2">Female</label>
                </div>

                <small id="check_Gender"></small>

            </div>


            <div class="col-sm-4">

                <div class="col-12 form-check form-switch">
                    <input class="form-check-input" type="checkbox" value="" id="check" switch>
                    <label class=" col-4 form-check-label" for="checkNativeSwitch">
                        Check Form
                    </label>

                </div>

            </div>


            <div class="col-sm-4 margin_bottom d-grid gap-2  mx-auto">
           
                <button class="btn btn-outline-warning fb" type="submit">Submit</button>
            </div>

            <div class="col-sm-4 margin_bottom d-grid gap-2 ">

                <button class="btn btn-outline-warning fb" type="reset">Reset</button>
            </div>
        </form>


